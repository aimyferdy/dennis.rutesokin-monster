---
import "../../styles/game.css";
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../lib/site";

import TOC from "../../components/TOC.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";

import { getCollection, render } from "astro:content";


export async function getStaticPaths() {

  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
    props: {
      post,
    },
  }));

}


const { post } = Astro.props;

const { Content, headings } = await render(post);


const posts = await getCollection("blog");


const displayImage =
  post.data.image?.trim()
  || `/api/og/${post.slug}.svg`;



const articleSchema = {

  "@context": "https://schema.org",

  "@type": "Article",

  headline: post.data.title,

  description: post.data.description,

  image: displayImage,

  url: SITE.url(`/blog/${post.slug}/`),

  author: {
    "@type": "Organization",
    name: SITE.name
  },

  publisher: {
    "@type": "Organization",
    name: SITE.name
  }

};

---


<MainLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  articleSchema={articleSchema}
  slug={post.slug}
>


<section class="game-hero">

  <div class="game-hero-bg">

    <img
      src={displayImage}
      alt=""
    />

  </div>


  <div class="game-hero-overlay"></div>


  <div class="container game-hero-inner">


    <nav class="breadcrumb">

      <a href="/">
        Beranda
      </a>

      <span>›</span>

      <a href="/blog/">
        Blog
      </a>

      <span>›</span>

      {post.data.title}

    </nav>



    <div class="game-hero-grid">


      <div class="game-hero-copy">


        <div class="game-hero-badge-row">

          {post.data.category && (

            <span class="game-tag game-tag-cat">
              {post.data.category}
            </span>

          )}

        </div>



        <h1>
          {post.data.title}
        </h1>


        {post.data.description && (

          <p class="game-detail-lead">

            {post.data.description}

          </p>

        )}


      </div>


      <aside class="game-hero-panel">

        <div class="game-panel-card">


          <img
            src={displayImage}
            alt={post.data.title}
            class="game-detail-icon"
            width="88"
            height="88"
          />


          <p class="game-panel-name">
            {post.data.title}
          </p>


          <p class="game-panel-label">
            Artikel Blog
          </p>


          <p class="game-panel-meta">

            {post.data.pubDate.toLocaleDateString("id-ID")}

          </p>


        </div>

      </aside>


    </div>


  </div>

</section>





<section class="section game-body">


<div class="container game-layout">


<main class="game-main">


<figure class="game-hero-shot">

<div class="game-shot-frame">

<img
 src={displayImage}
 alt={post.data.title}
 loading="eager"
 width="1200"
 height="630"
/>

</div>

</figure>





{headings.length > 0 && (

<details class="game-faq-details">

<summary>
📑 Daftar Isi
</summary>


<TOC headings={headings} />


</details>

)}





<article class="game-block game-article">


<header class="game-section-head">

<span class="game-section-num">
01
</span>


<h2>
{post.data.title}
</h2>


</header>



<div class="game-article-body">


<Content />


</div>


</article>





<RelatedPosts

posts={posts}

currentSlug={post.slug}

title="Artikel Terkait"

baseUrl="/blog"

/>



</main>


</div>


</section>



</MainLayout>
