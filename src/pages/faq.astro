---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'FAQ Robopragma - Pertanyaan Umum Seputar AI Otomatis dan Analisis Pintar';

const pageDescription =
  'Temukan jawaban lengkap seputar Robopragma, aplikasi AI otomatis yang membantu analisis data secara cepat, praktis, dan efisien. Pelajari cara kerja, fitur, keunggulan, serta informasi penting lainnya dalam halaman FAQ resmi Robopragma.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE.url()}/faq`}
>


  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>›</span>
        FAQ
      </nav>
      <h1>FAQ Pusat Unduh APK Ai Mr Dennis: Pertanyaan yang Sering Diajukan</h1>
      <p class="page-hero-lead">Halaman ini menjawab pertanyaan umum tentang unduhan, instalasi, versi, keamanan, dan dukungan aplikasi Ai Mr Dennis. Temukan informasi yang Anda butuhkan di sini.</p>
    </div>
  </section>

  <!-- FAQ Body -->
  <section class="section">
    <div class="container">

      <div class="faq-search" role="search">
        <label class="faq-search-label" for="faqSearchInput">Cari pertanyaan</label>
        <input type="search" id="faqSearchInput" class="faq-search-input" placeholder="Ketik kata kunci, misalnya unduh, instal, keamanan…" autocomplete="off" enterkeyhint="search">
        <p class="faq-search-status" id="faqSearchStatus" aria-live="polite" hidden></p>
      </div>

      <div class="faq-cats">
        <a href="#unduh">Unduh</a>
        <a href="#instal">Instal</a>
        <a href="#versi">Versi</a>
        <a href="#keamanan">Keamanan</a>
        <a href="#katalog">Katalog</a>
        <a href="#dukungan">Dukungan</a>
      </div>

      <!-- Unduh -->
      <div class="faq-group" id="unduh">
        <h2 class="faq-group-title"><span>📥</span> Unduh &amp; Akses</h2>

        <details class="faq-details">
          <summary>Bagaimana cara mengunduh APK Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Anda dapat mengunduh APK Ai Mr Dennis dengan mengunjungi situs resmi kami. Klik tombol download yang tersedia untuk versi terbaru dengan ukuran sekitar 36.3 MB.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah APK Ai Mr Dennis kompatibel dengan semua perangkat Android?</summary>
          <div class="faq-answer">
            <p>APK Ai Mr Dennis dirancang untuk kompatibilitas dengan berbagai perangkat Android, namun disarankan menggunakan versi terbaru untuk hasil optimal.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apa ukuran minimum ruang penyimpanan yang diperlukan untuk APK Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Untuk mengunduh dan menginstal APK Ai Mr Dennis, Anda memerlukan setidaknya 36.3 MB ruang penyimpanan kosong di perangkat Anda.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah saya perlu mengizinkan izin tertentu untuk mengunduh APK Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Ya, Anda perlu mengizinkan izin yang diperlukan untuk pengunduhan, termasuk izin untuk menginstal aplikasi dari sumber yang tidak dikenal.</p>
          </div>
        </details>
      </div>

      <!-- Instal -->
      <div class="faq-group" id="instal">
        <h2 class="faq-group-title"><span>📲</span> Instalasi</h2>

        <details class="faq-details">
          <summary>Bagaimana cara menginstal APK Ai Mr Dennis setelah diunduh?</summary>
          <div class="faq-answer">
            <p>Setelah mengunduh APK Ai Mr Dennis, buka file yang telah diunduh dan pilih opsi untuk menginstal. Ikuti petunjuk pada layar untuk menyelesaikan proses instalasi.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Mengapa instalasi APK Ai Mr Dennis gagal?</summary>
          <div class="faq-answer">
            <p>Instalasi APK Ai Mr Dennis dapat gagal jika perangkat Anda tidak memenuhi syarat atau jika izin untuk menginstal dari sumber tidak dikenal tidak diizinkan.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah saya perlu menghapus versi lama sebelum menginstal versi baru Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Tidak perlu menghapus versi lama, tetapi disarankan untuk memastikan bahwa semua data penting telah dicadangkan sebelum memperbarui ke versi baru.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apa yang harus dilakukan jika aplikasi Ai Mr Dennis tidak muncul setelah instalasi?</summary>
          <div class="faq-answer">
            <p>Jika aplikasi tidak muncul, coba restart perangkat Anda atau cek di menu aplikasi. Pastikan instalasi berhasil dan tidak ada pembatasan pada perangkat.</p>
          </div>
        </details>
      </div>

      <!-- Versi -->
      <div class="faq-group" id="versi">
        <h2 class="faq-group-title"><span>🔄</span> Versi &amp; Pembaruan</h2>

        <details class="faq-details">
          <summary>Apa versi terbaru dari APK Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Versi terbaru dari APK Ai Mr Dennis adalah versi 3.5.5. Pastikan Anda selalu mengunduh versi terbaru untuk mendapatkan fitur dan pembaruan terbaru.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara mengetahui apakah saya menggunakan versi terbaru Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Anda dapat memeriksa versi aplikasi dalam pengaturan aplikasi di perangkat Anda, atau bisa langsung mengunjungi situs kami untuk informasi terbaru.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah ada pembaruan rutin untuk APK Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Kami melakukan pembaruan secara rutin untuk APK Ai Mr Dennis guna memastikan performa optimal dan pengalaman pengguna yang lebih baik.</p>
          </div>
        </details>
      </div>

      <!-- Keamanan -->
      <div class="faq-group" id="keamanan">
        <h2 class="faq-group-title"><span>🔒</span> Keamanan</h2>

        <details class="faq-details">
          <summary>Apakah APK Ai Mr Dennis aman untuk diunduh dan diinstal?</summary>
          <div class="faq-answer">
            <p>APK Ai Mr Dennis aman untuk diunduh, karena kami memastikan bahwa file tidak mengandung virus dan dilindungi oleh sistem keamanan yang kuat.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara memastikan keamanan aplikasi Ai Mr Dennis setelah diinstal?</summary>
          <div class="faq-answer">
            <p>Pastikan untuk selalu mendownload dari situs resmi dan memperbarui aplikasi secara teratur. Selalu periksa izin yang diminta saat menginstal.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah Ai Mr Dennis mengumpulkan data pribadi pengguna?</summary>
          <div class="faq-answer">
            <p>Kami menghormati privasi pengguna dan tidak mengumpulkan data pribadi tanpa izin. Semua informasi yang dikumpulkan digunakan untuk meningkatkan layanan kami.</p>
          </div>
        </details>
      </div>

      <!-- Katalog & Aplikasi -->
      <div class="faq-group" id="katalog">
        <h2 class="faq-group-title"><span>📂</span> Katalog &amp; Aplikasi</h2>

        <details class="faq-details">
          <summary>Apa saja aplikasi yang tersedia di Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Ai Mr Dennis menyediakan berbagai aplikasi mulai dari game, aplikasi utilitas, hingga aplikasi hiburan yang dapat memenuhi kebutuhan pengguna.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara mencari aplikasi tertentu di Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Anda dapat menggunakan fitur pencarian pada situs kami untuk menemukan aplikasi tertentu dengan cepat. Cukup masukkan nama aplikasi yang Anda cari.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah ada kategori khusus untuk aplikasi di Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Ya, aplikasi di Ai Mr Dennis dibagi ke dalam kategori seperti permainan, produktivitas, dan lainnya, sehingga memudahkan pengguna dalam mencari.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara mendapatkan informasi terbaru tentang aplikasi baru di Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Anda dapat mengikuti situs resmi kami atau sosial media kami untuk mendapatkan berita dan pembaruan mengenai aplikasi baru yang tersedia di Ai Mr Dennis.</p>
          </div>
        </details>
      </div>

      <!-- Teknis & Dukungan -->
      <div class="faq-group" id="dukungan">
        <h2 class="faq-group-title"><span>🛠️</span> Teknis &amp; Dukungan</h2>

        <details class="faq-details">
          <summary>Di mana saya bisa mendapatkan dukungan teknis untuk Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Dukungan teknis untuk Ai Mr Dennis tersedia melalui halaman kontak di situs kami. Kami siap membantu Anda dengan masalah apapun yang Anda hadapi.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apa yang harus saya lakukan jika saya mengalami masalah saat menggunakan Ai Mr Dennis?</summary>
          <div class="faq-answer">
            <p>Jika Anda mengalami masalah, silakan hubungi tim dukungan kami melalui email atau form yang tersedia di situs untuk mendapatkan bantuan segera.</p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah Ai Mr Dennis menyediakan panduan pengguna?</summary>
          <div class="faq-answer">
            <p>Ya, kami menyediakan panduan pengguna lengkap yang dapat diakses di situs kami untuk membantu Anda memahami aplikasi dengan lebih baik.</p>
          </div>
        </details>
      </div>

      <!-- CTA -->
      <div class="faq-cta-strip">
        <h3>Belum menemukan jawaban?</h3>
        <p>Kunjungi halaman panduan, riwayat pembaruan, atau hubungi tim dukungan melalui email.</p>
        <div class="faq-cta-links">
          <a href="/Ai Mr Dennisinstal/">Panduan Instal</a>
          <a href="/Ai Mr Dennispembaruan/">Riwayat Pembaruan</a>
          <a href="/cdn-cgi/l/email-protection#ea8e9f819f848d8b84aa898b81988bdddddd989ac4898587"><span class="__cf_email__" data-cfemail="7115041a041f16101f3112101a031046464603015f121e1c">[email&#160;protected]</span></a>
        </div>
      </div>

    </div>
  </section>

<style is:global>
/* 8iifaq.html — Pertanyaan Umum */

.page-hero {
  background: linear-gradient(160deg, var(--green-900) 0%, var(--green-700) 100%);
  color: var(--white);
  padding: 48px 0 56px;
}

.breadcrumb {
  font-size: 0.85rem;
  margin-bottom: 20px;
  opacity: 0.9;
}

.breadcrumb a { color: var(--green-100); }
.breadcrumb a:hover { color: var(--white); }
.breadcrumb span { opacity: 0.6; margin: 0 8px; }

.page-hero h1 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  font-weight: 800;
  margin-bottom: 14px;
}

.page-hero-lead {
  font-size: 1.05rem;
  opacity: 0.92;
  max-width: 720px;
  line-height: 1.7;
}

.nav-desktop a.is-active,
.nav-mobile a.is-active {
  color: var(--green-600);
  font-weight: 600;
}

.faq-search {
  max-width: 800px;
  margin: 0 auto 24px;
  padding: 20px 24px;
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1px solid var(--green-100);
}

.faq-search-label {
  display: block;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--green-800);
  margin-bottom: 10px;
}

.faq-search-input {
  width: 100%;
  padding: 14px 18px;
  border: 2px solid var(--green-100);
  border-radius: 12px;
  font-size: 1rem;
  color: var(--gray-900);
  background: var(--green-50);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.faq-search-input:focus {
  outline: none;
  border-color: var(--green-500);
  box-shadow: 0 0 0 3px rgba(34, 139, 34, 0.12);
  background: var(--white);
}

.faq-search-status {
  margin: 10px 0 0;
  font-size: 0.88rem;
  color: var(--gray-600);
}

.faq-group[hidden] {
  display: none !important;
}

.faq-details[hidden] {
  display: none !important;
}

/* Category nav */
.faq-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-bottom: 40px;
}

.faq-cats a {
  background: var(--white);
  border: 1px solid var(--green-100);
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--green-700);
  box-shadow: var(--shadow);
}

.faq-cats a:hover {
  background: var(--green-50);
  color: var(--green-600);
}

/* FAQ groups */
.faq-group {
  max-width: 800px;
  margin: 0 auto 48px;
}

.faq-group-title {
  font-size: 1.15rem;
  color: var(--green-800);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--green-100);
}

.faq-group-title span {
  font-size: 1.2rem;
  margin-right: 8px;
}

.faq-details {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 12px;
  overflow: hidden;
  border: 1px solid var(--gray-100);
}

.faq-details[open] {
  border-left: 4px solid var(--green-500);
}

.faq-details summary {
  padding: 18px 24px;
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--gray-900);
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.faq-details summary::-webkit-details-marker { display: none; }

.faq-details summary::after {
  content: "+";
  font-size: 1.2rem;
  color: var(--green-600);
  font-weight: 700;
  flex-shrink: 0;
}

.faq-details[open] summary::after {
  content: "−";
}

.faq-details .faq-answer {
  padding: 0 24px 20px;
  font-size: 0.92rem;
  color: var(--gray-700);
  line-height: 1.7;
}

.faq-details .faq-answer a {
  font-weight: 600;
}

.faq-email {
  color: var(--green-600);
  word-break: break-all;
}

.faq-email:hover {
  color: var(--green-700);
  text-decoration: underline;
}

/* CTA strip */
.faq-cta-strip {
  background: var(--white);
  border-radius: var(--radius);
  padding: 32px;
  text-align: center;
  box-shadow: var(--shadow);
  max-width: 800px;
  margin: 0 auto;
}

.faq-cta-strip h3 {
  color: var(--green-800);
  margin-bottom: 10px;
  font-size: 1.1rem;
}

.faq-cta-strip p {
  color: var(--gray-500);
  font-size: 0.9rem;
  margin-bottom: 20px;
}

.faq-cta-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}

.faq-cta-links a {
  background: var(--green-50);
  border: 1px solid var(--green-100);
  padding: 10px 20px;
  border-radius: 50px;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--green-700);
}

.faq-cta-links a:hover {
  background: var(--green-100);
}
</style>
<script is:inline>
(function () {
  'use strict';

  var input = document.getElementById('faqSearchInput');
  var status = document.getElementById('faqSearchStatus');
  if (!input) return;

  var details = Array.prototype.slice.call(document.querySelectorAll('.faq-details'));
  var groups = Array.prototype.slice.call(document.querySelectorAll('.faq-group'));
  if (!details.length) return;

  function normalize(text) {
    return (text || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function rowText(el) {
    var summary = el.querySelector('summary');
    var answer = el.querySelector('.faq-answer');
    return normalize((summary ? summary.textContent : '') + ' ' + (answer ? answer.textContent : ''));
  }

  var cache = details.map(function (el) {
    return { el: el, text: rowText(el) };
  });

  function applyFilter() {
    var query = normalize(input.value);
    var visible = 0;

    cache.forEach(function (item) {
      var match = !query || item.text.indexOf(query) !== -1;
      item.el.hidden = !match;
      if (match) visible += 1;
    });

    groups.forEach(function (group) {
      var hasVisible = !!group.querySelector('.faq-details:not([hidden])');
      group.hidden = !hasVisible;
    });

    if (!status) return;

    if (!query) {
      status.hidden = true;
      status.textContent = '';
      return;
    }

    status.hidden = false;
    status.textContent = visible
      ? visible + ' pertanyaan ditemukan untuk "' + input.value.trim() + '"'
      : 'Tidak ada pertanyaan yang cocok. Coba kata kunci lain.';
  }

  input.addEventListener('input', applyFilter);
  input.addEventListener('search', applyFilter);
})();
</script>
</MainLayout>
